# Optional. Neon (or any Postgres reachable over Neon's HTTP driver) connection string.
# When set, progress syncs to the database so any machine can continue where you left off.
# When unset, progress lives only in the browser's localStorage.
DATABASE_URL=

# Optional. A passphrase required to read or write progress. Set this on a public
# deployment so strangers cannot overwrite your progress. Enter it once in the app
# (click the sync status in the header) and it is remembered per browser.
PROGRESS_SECRET=
